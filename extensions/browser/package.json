{
  "name": "portcheck-browser",
  "private": true,
  "version": "0.9.0",
  "description": "portcheck for Chrome and Edge: see which process serves a localhost page, and stop it.",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "build": "node esbuild.mjs",
    "build:store": "node esbuild.mjs --store",
    "build:firefox": "node esbuild.mjs --firefox",
    "build:firefox-direct": "node esbuild.mjs --firefox-direct",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run --coverage",
    "test:e2e": "npm run build && npm run build:store && playwright test",
    "test:e2e:firefox": "npm run build:firefox && node --test e2e-firefox/firefox.test.mjs",
    "check": "npm run typecheck && npm run lint && npm run test:unit && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.3.5",
    "@types/node": "22.20.5",
    "@types/selenium-webdriver": "4.35.7",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "selenium-webdriver": "4.51.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents": false
  }
}
