{
  "manifest_version": 3,
  "name": "Portcheck - Localhost Port Inspector",
  "short_name": "portcheck",
  "description": "See which process serves a localhost page (and who started it), stop it safely, and know why localhost refuses to connect.",
  "version": "0.0.0",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["nativeMessaging"],
  "host_permissions": [
    "http://localhost/*",
    "https://localhost/*",
    "http://*.localhost/*",
    "https://*.localhost/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*",
    "http://0.0.0.0/*",
    "http://[::1]/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "portcheck",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "homepage_url": "https://roystondwork-dev.github.io/portcheck/guide/browser/"
}
