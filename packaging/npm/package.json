{
  "name": "portcheck-cli",
  "version": "0.10.1",
  "description": "See what's using a port and free it safely: a safer kill-port that shows the process and who started it before stopping it. Fixes \"port already in use\" (EADDRINUSE).",
  "mcpName": "io.github.roystondwork-dev/portcheck",
  "keywords": [
    "port",
    "eaddrinuse",
    "port-in-use",
    "kill-port",
    "lsof",
    "netstat",
    "localhost",
    "dev-server",
    "cli",
    "kill",
    "killport",
    "port-kill",
    "address-already-in-use",
    "port-3000",
    "free-port",
    "process"
  ],
  "homepage": "https://roystondwork-dev.github.io/portcheck/",
  "bugs": "https://github.com/roystondwork-dev/portcheck/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roystondwork-dev/portcheck.git",
    "directory": "packaging/npm"
  },
  "license": "MIT",
  "author": "Royston D",
  "bin": {
    "portcheck": "bin/portcheck.js",
    "portcheck-cli": "bin/portcheck.js"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./register": "./lib/register.js",
    "./vite": {
      "types": "./lib/vite.d.ts",
      "default": "./lib/vite.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "files": [
    "bin",
    "lib",
    "checksums.json",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
